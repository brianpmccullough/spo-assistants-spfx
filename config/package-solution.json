{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/package-solution.schema.json",
  "solution": {
    "name": "spo-assistants-spfx-client-side-solution",
    "id": "b6ffb0a6-57ee-4041-9ee7-37e858083564",
    "version": "0.1.5.0",
    "includeClientSideAssets": true,
    // The package carries code only: no elements.xml, no <CustomAction>. scripts/deploy.ps1
    // provisions the customizer per site with Add-PnPCustomAction, so the app must be
    // explicitly installed on a site (skipFeatureDeployment must stay false).
    "skipFeatureDeployment": false,
    "isDomainIsolated": false,
    // "resource" must match the display name of the site assistant API's Entra ID app
    // registration, and "scope" one of the scopes it exposes. A tenant admin approves
    // this request under SharePoint admin center > Advanced > API access before
    // AadHttpClientFactory can issue tokens for the API.
    "webApiPermissionRequests": [
      {
        "resource": "spo-assistants",
        "scope": "user_impersonation"
      }
    ],
    "developer": {
      "name": "",
      "websiteUrl": "",
      "privacyUrl": "",
      "termsOfUseUrl": "",
      "mpnId": "Undefined-1.23.2"
    },
    "metadata": {
      "shortDescription": {
        "default": "spo-assistants-spfx description"
      },
      "longDescription": {
        "default": "spo-assistants-spfx description"
      },
      "screenshotPaths": [],
      "videoUrl": "",
      "categories": []
    }
  },
  "paths": {
    "zippedPackage": "solution/spo-assistants-spfx.sppkg"
  }
}
